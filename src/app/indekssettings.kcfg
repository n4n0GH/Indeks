<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name="indeksrc"/>
    <group name="Indexing">
        <entry name="indexContent" type="Bool">
            <label>Read the text inside files so that it can be searched.</label>
            <default>true</default>
        </entry>
        <entry name="indexHidden" type="Bool">
            <label>Include hidden files and folders of indexed locations.</label>
            <default>false</default>
        </entry>
        <entry name="rescanOnStart" type="Bool">
            <label>Look for changes in all indexed locations when Indeks starts.</label>
            <default>true</default>
        </entry>
        <entry name="officeConversion" type="Bool">
            <label>Have LibreOffice read Office documents whose text cannot be read otherwise.</label>
            <default>true</default>
        </entry>
        <entry name="indexJobs" type="Int">
            <label>How many files are read at once when indexing; 0 picks half of the processor cores, eight at most.</label>
            <default>0</default>
            <min>0</min>
            <max>16</max>
        </entry>
        <entry name="maxContentSizeMb" type="Int">
            <label>Files larger than this are indexed by name only.</label>
            <default>100</default>
            <min>1</min>
            <max>4096</max>
        </entry>
        <entry name="maxRemoteSizeMb" type="Int">
            <label>Remote files larger than this are not downloaded for indexing.</label>
            <default>50</default>
            <min>1</min>
            <max>4096</max>
        </entry>
    </group>
    <group name="Databases">
        <entry name="localDatabaseName" type="String">
            <label>What the user calls the database every installation has; empty for its usual name.</label>
            <default></default>
        </entry>
        <entry name="databaseNames" type="StringList">
            <label>Names of the databases added besides the local one.</label>
            <default></default>
        </entry>
        <entry name="databasePaths" type="StringList">
            <label>Their folders, in the same order.</label>
            <default></default>
        </entry>
        <entry name="activeDatabase" type="String">
            <label>Folder of the database to open at start; empty for the local one.</label>
            <default></default>
        </entry>
    </group>
    <group name="Ocr">
        <entry name="ocrEnabled" type="Bool">
            <label>Recognize text in images and scanned PDF documents.</label>
            <default>true</default>
        </entry>
        <entry name="ocrJobs" type="Int">
            <label>How many pages or pictures are read for text at once; 0 picks most of the processor cores.</label>
            <default>0</default>
            <min>0</min>
            <max>64</max>
        </entry>
        <entry name="ocrLanguages" type="String">
            <label>Tesseract languages to recognize, joined with a plus sign.</label>
            <default>eng</default>
        </entry>
    </group>
    <group name="View">
        <entry name="leftSidebarVisible" type="Bool">
            <default>true</default>
        </entry>
        <entry name="rightSidebarVisible" type="Bool">
            <default>true</default>
        </entry>
        <entry name="todoWarningDays" type="Int">
            <label>From how many days before it is due a to-do stands out as due soon.</label>
            <default>3</default>
            <min>0</min>
            <max>365</max>
        </entry>
        <entry name="sidebarSections" type="StringList">
            <label>The sections of the database view that have a heading, in the order they are listed in. See SidebarModel::sectionOrder.</label>
            <default>smart,searches,groups,tags,sources</default>
        </entry>
        <entry name="panelLeftTop" type="StringList">
            <label>The views in the upper area of the sidebar on the left, in the order of their tabs. See PanelLayout.</label>
            <default>database,automation</default>
        </entry>
        <entry name="panelLeftBottom" type="StringList">
            <label>The views in the lower area of the sidebar on the left.</label>
            <default></default>
        </entry>
        <entry name="panelRightTop" type="StringList">
            <label>The views in the upper area of the side panel on the right.</label>
            <default>info,find</default>
        </entry>
        <entry name="panelRightBottom" type="StringList">
            <label>The views in the lower area of the side panel on the right.</label>
            <default>todo</default>
        </entry>
        <entry name="panelCurrent" type="StringList">
            <label>The view each area shows: left above, left below, right above, right below.</label>
            <default>database,,info,todo</default>
        </entry>
        <entry name="leftPanelLower" type="Double">
            <label>How much of the height of the sidebar on the left its lower area takes.</label>
            <default>0.4</default>
            <min>0.1</min>
            <max>0.9</max>
        </entry>
        <entry name="rightPanelLower" type="Double">
            <label>How much of the height of the side panel on the right its lower area takes.</label>
            <default>0.4</default>
            <min>0.1</min>
            <max>0.9</max>
        </entry>
        <entry name="previewVisible" type="Bool">
            <default>true</default>
        </entry>
        <entry name="previewBeside" type="Bool">
            <label>Whether the preview stands to the right of the list of documents instead of below it.</label>
            <default>false</default>
        </entry>
        <entry name="previewTextZoom" type="Double">
            <label>How large text is shown in the preview, 1 being the size of the desktop's fonts.</label>
            <default>1</default>
            <min>0.5</min>
            <max>4</max>
        </entry>
        <entry name="listColumns" type="StringList">
            <label>What the list of documents shows of each document besides its name, in the order of the columns.</label>
            <default>kind,tags,modified,added,size</default>
        </entry>
        <entry name="listColumnWidths" type="StringList">
            <label>Widths the user gave columns of the list, as name=width in units of the grid.</label>
            <default></default>
        </entry>
        <entry name="listRowSize" type="Int">
            <label>How tall the rows of the list are: 0 compact, 1 normal, 2 tall.</label>
            <default>1</default>
            <min>0</min>
            <max>2</max>
        </entry>
        <entry name="sortColumn" type="String">
            <default>modified</default>
        </entry>
        <entry name="sortDescending" type="Bool">
            <default>true</default>
        </entry>
        <entry name="collapsedSections" type="StringList">
            <default></default>
        </entry>
        <entry name="toolbarActions" type="StringList">
            <label>What the toolbar shows between the buttons for the sidebar and the side panel: names of actions, "menu_add", "menu_new", "separator", "search_field", and "spacer", after which everything stands at the far end.</label>
            <default>menu_add,menu_new,separator,doc_tag,doc_group,doc_flag,separator,doc_open,doc_trash,spacer,search_field,search_advanced,save_search,menu_preview</default>
        </entry>
        <entry name="toolbarLayout" type="Int">
            <label>Which form toolbarActions is in. From 2 on it names the search field and the buttons beside it, which had fixed places before. From 3 on one button with a menu (menu_preview) stands for the two buttons of the preview.</label>
            <default>1</default>
        </entry>
        <entry name="toolbarIconsOnly" type="Bool">
            <label>Show the toolbar buttons without their text.</label>
            <default>false</default>
        </entry>
    </group>
</kcfg>
